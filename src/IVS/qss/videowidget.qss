/* ====== 基础重置 ====== */
* {
    margin: 0;
    padding: 0;
}

/* ====== 左侧整体侧边栏 ====== */
#left_box {
    border-right: 1px solid #333333; /* 分割线改为深灰色，融入暗黑主题 */
    min-width: 200px;
    background-color: transparent;
}

/* ====== 列表标题样式 ====== */
#lab_dates_title {
    color: white;
    font-size: 14pt;
    font-weight: bold;
    padding: 15px 10px;
    border-bottom: 2px solid #444444; /* 标题底部的下划线 */
}

/* ====== 列表控件整体样式 ====== */
#days_list {
    background-color: transparent;
    border: none;
    outline: none; /* 消除点击选中时的虚线框 */
}

/* ====== 列表条目基础样式 ====== */
#days_list::item {
    min-height: 55px; /* 使用 min-height 撑开高度，解决文字重叠问题 */
    padding-left: 10px; /* 图标和文字的左边距 */
    color: #E0E0E0; /* 默认字体颜色（稍微偏灰，不至于太刺眼） */
    font-size: 14pt;
    border-bottom: 1px solid #1A1A1A; /* 每行之间的微弱分割线，增加间距感 */
}

/* ====== 列表底部按钮 ====== */
#btn_pre, #btn_next {
    font-size: 5pt;
    color: white;
    min-width: 60px;
    min-height: 50px;
}

/* ====== 鼠标悬浮状态 (Hover) ====== */
#days_list::item:hover {
    background-color: #2A2A2A; /* 鼠标放上去显示深灰背景 */
    color: #FFFFFF; /* 字体变纯白 */
}

/* ====== 选中状态 (Selected) ====== */
#days_list::item:selected {
    background-color: #1A73E8;
    color: #FFFFFF;
    border-left: 4px solid #8AB4F8; /* 左侧增加一条高亮指示条，让选中效果更明显 */
}

/* ====== 选中且鼠标悬浮状态 ====== */
#days_list::item:selected:hover {
    background-color: #155EBF; /* 颜色稍微加深，增加点击反馈 */
}

/* ====== 彻底隐藏滚动条 ====== */
#days_list QScrollBar:vertical,
#days_list QScrollBar:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
}

/* =========================================
   1. 顶部日期按钮与通道下拉框统一样式
   ========================================= */
/* 让左侧盒子里的下拉框和按钮看起来像统一的现代控件 */
#left_box QPushButton,
#left_box QComboBox {
    background-color: #444444;       /* 深灰背景 */
    color: #FFFFFF;                  /* 白色纯净文字 */
    border: 1px solid #666666;       /* 细边框 */
    border-radius: 4px;              /* 圆角 */
    padding: 5px 15px;               /* 内边距，让文字不拥挤 */
    font-size: 14px;
    font-family: "Microsoft YaHei";
    min-height: 30px;
}

/* 鼠标悬浮反馈 */
#left_box QPushButton:hover,
#left_box QComboBox:hover {
    background-color: #555555;
    border: 1px solid #888888;
}

/* =========================================
   2. 下拉框 (QComboBox) 展开列表美化
   ========================================= */
/* 下拉框点开后的列表区域 */
#left_box QComboBox QAbstractItemView {
    background-color: #333333;       /* 更深的底色 */
    color: #FFFFFF;
    border: 1px solid #666666;
    border-radius: 4px;
    selection-background-color: #4CAF50; /* 选中时的绿色高亮 */
    selection-color: #FFFFFF;
    outline: none;                   /* 去除原生的虚线焦点框 */
}

/* 下拉按钮区域去边框化 */
#left_box QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* =========================================
   3. 日历控件 (QCalendarWidget) 深度美化
   ========================================= */
/* 日历最外层的悬浮容器 */
DatePicker QFrame {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 8px;
}

/* 顶部导航栏 (包含年月和左右箭头) - 这是 Qt 内部固定的 ObjectName */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #444444;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 35px;
}

/* 导航栏上的按钮 (年月、左右翻页箭头) */
QCalendarWidget QToolButton {
    color: #FFFFFF;
    background-color: transparent;
    font-size: 14px;
    font-weight: bold;
    margin: 2px;
    border-radius: 4px;
}
/* 导航按钮悬浮与按下状态 */
QCalendarWidget QToolButton:hover {
    background-color: #555555;
}
QCalendarWidget QToolButton:pressed {
    background-color: #222222;
}

/* 日期网格视图本体 */
QCalendarWidget QAbstractItemView:enabled {
    background-color: #333333;       /* 日历主体深色背景 */
    color: #E0E0E0;                  /* 普通日期浅灰色 */
    selection-background-color: #4CAF50; /* 选中日期的绿色底 */
    selection-color: #FFFFFF;        /* 选中日期的白色字 */
    outline: none;                   /* 去除丑陋的焦点虚线 */
}

/* 禁用的日期 (比如超出最小/最大范围的日期) */
QCalendarWidget QAbstractItemView:disabled {
    color: #666666;
}

/* 点击月份时弹出的月份选择菜单 */
QCalendarWidget QMenu {
    background-color: #333333;
    color: #FFFFFF;
    border: 1px solid #555555;
}
QCalendarWidget QMenu::item:selected {
    background-color: #4CAF50;
}

/* 点击年份时弹出的微调输入框 */
QCalendarWidget QSpinBox {
    background-color: #444444;
    color: #FFFFFF;
    border: 1px solid #666666;
    selection-background-color: #4CAF50;
}

/* =========================================
   视频下方控制栏专用美化
   ========================================= */

/* 1. 圆形播放/暂停按钮 */
QPushButton#btn_ctr {
    background-color: black;
    color: white;
    border: none;
    /* 要做成绝对的圆形，宽高必须固定，且 border-radius 等于宽高的一半 */
    min-width: 50px;
    max-width: 50px;
    min-height: 50px;
    max-height: 50px;
    border-radius: 25px;         /* 50的一半 */
    font-size: 16px;
    font-weight: bold;
    font-family: "Microsoft YaHei";

    padding: 0px;
}
/* 播放按钮鼠标悬浮与按下状态 */
QPushButton#btn_ctr:hover {
    background-color: black;   /* 悬浮稍微变深 */
}
QPushButton#btn_ctr:pressed {
    background-color: black;   /* 按下更深一点 */
    padding-top: 2px;            /* 按下时文字稍微下移，增加立体按压感 */
}


/* 2. 截图按钮（扁平化圆角风格） */
QPushButton#btn_capture_img {
    background-color: #555555;
    color: #FFFFFF;
    border: 1px solid #777777;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
    font-family: "Microsoft YaHei";
    min-height: 30px;
}
QPushButton#btn_capture_img:hover {
    background-color: #666666;
    border: 1px solid #888888;
}
QPushButton#btn_capture_img:pressed {
    background-color: #444444;
}


/* 3. 倍速下拉选择框 */
QComboBox#box_speed {
    background-color: #555555;
    color: white;
    border: 1px solid #777777;
    border-radius: 6px;
    padding: 5px 15px;
    font-size: 14px;
    font-weight: bold;
    min-width: 60px;
    min-height: 30px;
}
QComboBox#box_speed:hover {
    background-color: #666666;
    border: 1px solid #888888;
}
/* 倍速框右侧的小箭头区域去边框化 */
QComboBox#box_speed::drop-down {
    border: none;
    width: 20px;
}
/* 倍速框展开的列表项 */
QComboBox#box_speed QAbstractItemView {
    background-color: #444444;
    color: white;
    selection-background-color: #4CAF50;
    selection-color: white;
    border: 1px solid #666666;
    outline: none;
}


/* 4. 进度条 (QSlider) 深度美化 */
/* 进度条底槽 (没播到的部分) */
QSlider#video_slider::groove:horizontal, #slider_img_size::groove:horizontal {
    border: none;
    height: 6px;                 /* 进度条的粗细 */
    background: #444444;         /* 暗灰色槽 */
    border-radius: 3px;
}
/* 进度条滑过的部分 (已播部分) */
QSlider#video_slider::sub-page:horizontal, #slider_img_size::sub-page:horizontal {
    background: #4CAF50;         /* 绿色的已播进度 */
    border-radius: 3px;
}
/* 进度条的拖动小圆球 (Handle) */
QSlider#video_slider::handle:horizontal, #slider_img_size::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #4CAF50;
    width: 14px;                 /* 圆球的宽度 */
    margin-top: -5px;            /* 让圆球超出轨道上下边缘 */
    margin-bottom: -5px;
    border-radius: 7px;          /* 变成圆形 */
}
/* 鼠标放上小圆球时的效果 */
QSlider#video_slider::handle:horizontal:hover, #slider_img_size::handle:horizontal:hover {
    background: #E8F5E9;         /* 微微泛绿的白色 */
}

/* 上方选择视频查询还是图片查询按钮 */
QPushButton#btn_video_opt, #btn_img_opt, #btn_related_video, #btn_img_expand, #btn_img_reduce, #btn_img_fitwin {
    background-color: #555555;
    color: #FFFFFF;
    border: 1px solid #777777;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    min-height: 30px;
}

QPushButton#btn_video_opt:hover, #btn_img_opt:hover, #btn_related_video:hover, #btn_img_expand:hover, #btn_img_reduce:hover, #btn_img_fitwin:hover {
    background-color: #666666;
    border: 1px solid #888888;
}
QPushButton#btn_video_opt:pressed, #btn_img_opt:pressed, #btn_related_video:pressed, #btn_img_expand:pressed, #btn_img_reduce:pressed, #btn_img_fitwin:pressed {
    background-color: #444444;
}
